import os
import re
from typing import Final

import pulumi
import pulumi_datarobot
from datarobot_pulumi_utils.schema.apps import ApplicationSourceArgs
from datarobot_pulumi_utils.schema.apps import CustomAppResourceBundles
from datarobot_pulumi_utils.schema.exec_envs import RuntimeEnvironments
from datarobot_pulumi_utils.pulumi.stack import PROJECT_NAME

from . import project_dir, use_case

SESSION_SECRET_KEY: Final[str] = "SESSION_SECRET_KEY"
session_secret_key = os.environ.get(SESSION_SECRET_KEY)

required_key_scope_level: str = "{{ api_key_scope_level }}"

EXCLUDE_PATTERNS = [
    re.compile(pattern)
    for pattern in [
        # Runtime parameters are passed via the API; uploading a metadata.yaml
        # alongside them is rejected by the platform. Also filters stale
        # metadata.yaml/metadata.yaml.jinja files generated by older versions
        # of this template.
        r"metadata\.yaml",
        r".*htmlcov/.*",
        r".*tests/.*",
        r".*\.coverage",
        r".*\.DS_Store",
        r".*\.pyc",
        r".*\.ruff_cache/.*",
        r".*\.venv/.*",
        r".*\.mypy_cache/.*",
        r".*__pycache__/.*",
        r".*\.pytest_cache/.*",
        r".*\.uv/.*",
    ]
]


__all__ = [
    "{{fastapi_app_name}}_app",
    "{{fastapi_app_name}}_app_env_name",
    "{{fastapi_app_name}}_app_resource_name",
    "{{fastapi_app_name}}_app_runtime_parameters",
    "{{fastapi_app_name}}_app_source",
    "{{fastapi_app_name}}_application_path",
    "get_{{fastapi_app_name}}_app_files",
]


def get_{{fastapi_app_name}}_app_files() -> list[tuple[str, str]]:
    # Get all files from application path, following symlinks
    # When we've upgraded to Python 3.13 we can use Path.glob(resuce_symlinks=True)
    # https://docs.python.org/3.13/library/pathlib.html#pathlib.Path.glob
    source_files = []
    for dirpath, dirnames, filenames in os.walk({{fastapi_app_name}}_application_path, followlinks=True):
        for filename in filenames:
            file_path = os.path.join(dirpath, filename)
            rel_path = os.path.relpath(file_path, {{fastapi_app_name}}_application_path)
            # Convert to forward slashes for Linux destination
            rel_path = rel_path.replace(os.path.sep, "/")
            source_files.append((os.path.abspath(file_path), rel_path))
    source_files = [
        (file_path, file_name)
        for file_path, file_name in source_files
        if not any(
            exclude_pattern.match(file_name) for exclude_pattern in EXCLUDE_PATTERNS
        )
    ]

    return source_files


# Start of Pulumi settings and application infrastructure
pulumi.export("SESSION_SECRET_KEY", session_secret_key)
session_secret_cred = pulumi_datarobot.ApiTokenCredential(
    f"{{ _external_data.base.template_name }} Session Secret Key [{PROJECT_NAME}]",
    args=pulumi_datarobot.ApiTokenCredentialArgs(
        api_token=str(session_secret_key),
    ),
)
{{fastapi_app_name}}_app_env_name: str = "DATAROBOT_APPLICATION_ID"
{{fastapi_app_name}}_application_path = project_dir.parent / "{{fastapi_app_name}}"

{{fastapi_app_name}}_exec_env = os.environ.get(
    "DATAROBOT_DEFAULT_APPLICATION_EXECUTION_ENVIRONMENT", ""
).strip()
{{fastapi_app_name}}_base_environment_id = (
    app_exec_env or RuntimeEnvironments.PYTHON_312_APPLICATION_BASE.value.id
)

{{fastapi_app_name}}_app_source_args = ApplicationSourceArgs(
    resource_name=f"{{ _external_data.base.template_name }} [{PROJECT_NAME}]",
    base_environment_id={{fastapi_app_name}}_base_environment_id,
).model_dump(mode="json", exclude_none=True)

{{fastapi_app_name}}_app_resource_name: str = f"{{ _external_data.base.template_name }} [{PROJECT_NAME}]"
{{fastapi_app_name}}_app_runtime_parameters: list[
    pulumi_datarobot.ApplicationSourceRuntimeParameterValueArgs
] = [
    pulumi_datarobot.ApplicationSourceRuntimeParameterValueArgs(
        type="credential",
        key=SESSION_SECRET_KEY,
        value=session_secret_cred.id,
    ),
]
custom_model_credential_runtime_parameters = [
    pulumi_datarobot.CustomModelRuntimeParameterValueArgs(
        type="credential",
        key=SESSION_SECRET_KEY,
        value=session_secret_cred.id,
    ),
]

{{fastapi_app_name}}_app_source = pulumi_datarobot.ApplicationSource(
    files=get_{{fastapi_app_name}}_app_files(),
    runtime_parameter_values={{fastapi_app_name}}_app_runtime_parameters,
    resources=pulumi_datarobot.ApplicationSourceResourcesArgs(
        resource_label=CustomAppResourceBundles.CPU_XL.value.id,
    ),
    required_key_scope_level=required_key_scope_level,
    **{{fastapi_app_name}}_app_source_args,
)

{{fastapi_app_name}}_app = pulumi_datarobot.CustomApplication(
    resource_name={{fastapi_app_name}}_app_resource_name,
    source_version_id={{fastapi_app_name}}_app_source.version_id,
    use_case_ids=[use_case.id],
    allow_auto_stopping=True,
    resources={{fastapi_app_name}}_app_source.resources,
    required_key_scope_level={{fastapi_app_name}}_app_source.required_key_scope_level,
    opts=pulumi.ResourceOptions(depends_on=[{{fastapi_app_name}}_app_source]),
)

pulumi.export({{fastapi_app_name}}_app_env_name, {{fastapi_app_name}}_app.id)
pulumi.export(
    {{fastapi_app_name}}_app_resource_name,
    {{fastapi_app_name}}_app.application_url,
)
