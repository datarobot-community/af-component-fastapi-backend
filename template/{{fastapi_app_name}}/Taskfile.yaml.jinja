---
# https://taskfile.dev
version: '3'

# In Notebooks, drop PYTHONPATH to avoid dependency collisions
env:
  CALCULATED_PYTHONPATH: "{% raw %}{{ if and .PYTHONPATH .NOTEBOOK_ID }}{{ else }}{{ .PYTHONPATH }}{{ end }}{% endraw %}"

tasks:

  auth-check:
    silent: true
    desc: "🔐 Check authentication prerequisites"
    cmds:
      - |
        if command -v dr &> /dev/null && dr auth help 2>&1 | grep -q "check"; then
          echo "🔐 Checking authentication.."
          dr auth check
        else
          echo "ℹ️  Skipping auth check (not available)"
        fi

  install:
    desc: "🔧 Install dependencies"
    cmds:
      - echo "🔧 Installing dependencies.."
      - uv sync --all-extras --dev

  dev:
    silent: true
    desc: "🔨 Run the development server"
    deps:
      - auth-check
{% if 'fastapi_auth' in my_transitive_reverse_dependency_modules %}
    env:
      TEST_USER_EMAIL: developer@example.com
{% endif %}
    cmds:
      - echo "🔨 Starting development server"
{% if 'react' in my_transitive_reverse_dependency_modules %}
      - cd ../{% for _dep_label in my_transitive_reverse_dependencies %}{% if label_modules[_dep_label] | module_short_name == 'react' %}{{ label_answers[_dep_label].react_app_name }}{% endif %}{% endfor %} && task build && cd ../{{ fastapi_app_name }}
{% endif %}
{% if 'fastapi_memory' in my_transitive_reverse_dependency_modules %}
      - |
        _memory_space_id=$(python3 -c "import json,sys; d=json.load(open('../pulumi_config.json')); sys.stdout.write(d.get('APPLICATION_MEMORY_SPACE_ID',''))" 2>/dev/null || echo "")
        if [ -z "$_memory_space_id" ]; then
          echo "❌ APPLICATION_MEMORY_SPACE_ID not found in pulumi_config.json. Run 'task -d ../infra deploy-dev' first."
          exit 1
        fi
        APPLICATION_MEMORY_SPACE_ID="$_memory_space_id" PYTHONPATH="$CALCULATED_PYTHONPATH" uv run uvicorn app.main:app --host 0.0.0.0 --port {{ fastapi_local_port }} --reload
{% else %}
      - PYTHONPATH="$CALCULATED_PYTHONPATH" uv run uvicorn app.main:app --host 0.0.0.0 --port {{ fastapi_local_port }} --reload
{% endif %}

  lint:
    silent: true
    desc: "🧹 Run linters"
    cmds:
      - echo "🧹 Running linters.."
      - uv run ruff format .
      - uv run ruff check . --fix
      - PYTHONPATH="$CALCULATED_PYTHONPATH" uv run mypy --pretty .

  lint-check:
    silent: true
    desc: "🧹 Check whether the codebase is linted"
    cmds:
      - uv run ruff format --check .
      - uv run ruff check .
      - PYTHONPATH="$CALCULATED_PYTHONPATH" uv run mypy --pretty .

  test:
    silent: true
    desc: "🧪 Run tests"
    cmds:
      - echo "🧪 Running tests.."
      - PYTHONPATH="$CALCULATED_PYTHONPATH" uv run pytest --cov --cov-report=html --cov-report=term --cov-report xml:.coverage.xml

  copyright:
    aliases: [license]
    desc: 📜 Apply license headers
    cmds:
      - echo "📜 Applying license headers"
      - docker run  --rm -v $PWD:/github/workspace ghcr.io/apache/skywalking-eyes/license-eye:eb0e0b091ea41213f712f622797e37526ca1e5d6
        -v info -c .licenserc.yaml header fix

  copyright-check:
    aliases: [license-check]
    desc: 📜 Checking for license headers
    cmds:
      - echo "📜 Checking license headers"
      - docker run  --rm -v $PWD:/github/workspace ghcr.io/apache/skywalking-eyes/license-eye:eb0e0b091ea41213f712f622797e37526ca1e5d6
        -v info -c .licenserc.yaml header check
